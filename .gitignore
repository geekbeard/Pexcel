# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# PyInstaller output
build/
# Keep the built exe in the repo, ignore everything else PyInstaller drops in dist/
dist/*
!dist/Pexcel.exe
*.spec

